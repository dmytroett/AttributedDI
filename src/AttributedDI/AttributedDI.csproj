<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <Description>Attribute-driven DI registration with source-generated wiring and optional interface generation.</Description>
    <Authors>Dmytro Ett</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/dmytroett/AttributedDI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dmytroett/AttributedDI</RepositoryUrl>
    <PackageTags>dependencyinjection;di;AoP;sourcegenerator;aot</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-nuget.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference version range [8.0.0, 11.0.0) - allows v8, v9, v10 but prevents v11+ if breaking changes introduced
         Developers can use any version in this range without forced upgrades or downgrades -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,11.0.0)"/>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AttributedDI.SourceGenerator\AttributedDI.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the generator into the NuGet package as an analyzer -->
    <None Include="..\AttributedDI.SourceGenerator\bin\$(Configuration)\netstandard2.0\AttributedDI.SourceGenerator.dll"
          Pack="true" 
          PackagePath="analyzers/dotnet/cs" 
          Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="AttributedDI.props"
          Pack="true"
          PackagePath="buildTransitive/"
          Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="icon-nuget.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
