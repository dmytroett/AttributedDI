<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAttributedDIExtensions>false</GenerateAttributedDIExtensions>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsE2E)' != 'true'">
    <ProjectReference Include="..\..\..\..\src\AttributedDI\AttributedDI.csproj" />
    <ProjectReference
      Include="..\..\..\..\src\AttributedDI.SourceGenerator\AttributedDI.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsE2E)' == 'true'">
    <PackageReference Include="AttributedDI" Version="$(AttributedDIPackageVersion)" />
  </ItemGroup>

</Project>
