<Project>
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</RepoRoot>
    <E2ELocalFeed>$(RepoRoot)\test\e2e\.nuget\feed</E2ELocalFeed>
    <E2EGlobalPackages>$(RepoRoot)\test\e2e\.nuget\packages</E2EGlobalPackages>
    <RestoreConfigFile>$(RepoRoot)\test\e2e\assets\nuget.config</RestoreConfigFile>
    <AttributedDIPackageVersion Condition="'$(AttributedDIPackageVersion)' == ''">99.0.0-e2e</AttributedDIPackageVersion>
    <AttributedDIPackProject>$(RepoRoot)\src\AttributedDI\AttributedDI.csproj</AttributedDIPackProject>
  </PropertyGroup>
</Project>
