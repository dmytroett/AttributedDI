<Project>
  <PropertyGroup>
    <E2ENugetRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</E2ENugetRoot>
    <E2ELocalFeed>$([System.IO.Path]::Combine('$(E2ENugetRoot)', '.nuget', 'feed'))</E2ELocalFeed>
    <E2EGlobalPackages>$([System.IO.Path]::Combine('$(E2ENugetRoot)', '.nuget', 'packages'))</E2EGlobalPackages>
    <RestoreConfigFile>$([System.IO.Path]::Combine('$(E2ENugetRoot)', 'nuget.config'))</RestoreConfigFile>
    <E2EPackageVersion Condition="'$(E2EPackageVersion)' == ''">99.0.0-e2e</E2EPackageVersion>
    <AttributedDIPackageVersion Condition="'$(AttributedDIPackageVersion)' == ''">$(E2EPackageVersion)</AttributedDIPackageVersion>
  </PropertyGroup>
</Project>
